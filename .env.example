# KinetoFun environment variables.
# Copy to `.env.local` and fill in. `.env*` is git-ignored.

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs (HS256). REQUIRED in production (>= 32 chars).
# In development a built-in insecure fallback is used if this is unset.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=

# ── Database: Supabase (PostgreSQL only — NOT Supabase Auth) ─────────────────
# When BOTH are set, users are stored in Supabase Postgres via its REST API.
# When unset, the app falls back to a local file store (.data/auth-users.json)
# so you can run and test auth with zero setup.
#
# Find these in: Supabase Dashboard → Project Settings → API.
# The service-role key is SECRET and server-only — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── TV pairing (/tvsetup) ────────────────────────────────────────────────────
# OPTIONAL. The absolute origin baked into the QR code the TV displays, e.g.
# https://kinetofun.example. Leave unset and the origin is derived from the
# request's forwarded host/proto headers, which is correct for both local dev
# and a normal proxied deployment. Set it only if the TV must be handed a
# different public URL than the one it called (e.g. a Pi reaching the app over
# a LAN address while phones scan a public domain).
NEXT_PUBLIC_APP_URL=

# ── Email: Resend (password reset) ────────────────────────────────────────────
# When unset, emails are logged to the console instead of sent — useful for
# local dev without a real provider. Get a key at https://resend.com/api-keys.
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. Defaults to their sandbox address
# (onboarding@resend.dev) if unset, which only delivers to your own Resend account email.
EMAIL_FROM=
