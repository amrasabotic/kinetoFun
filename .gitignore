# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — root and all nested (game subdirectories)
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
**/.next/

# game build outputs
**/dist/
**/out/
public/games/

# production
/build

# misc
.DS_Store
*.pem

# local auth data store (dev fallback when Supabase isn't configured)
/.data

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
